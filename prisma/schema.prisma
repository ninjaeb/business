// Prisma schema for the Gotka Business Directory (business.gotka.com)
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PARTNER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  title        String?
  role         Role     @default(PARTNER)
  phone        String?
  companyName  String?
  timezone     String?
  currency     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  partnerListings      PartnerListing[]
  directoryLeadReplies DirectoryLeadReply[]

  // Leads/views attributed to this partner's own Recommend link for
  // someone else's (or their own) listing — see DirectoryLead.referrerId
  // and ListingReferralView.
  referredDirectoryLeads DirectoryLead[]
  listingReferralViews   ListingReferralView[]

  // Business-portal CRM — see the models below.
  partnerCompanies     PartnerCompany[]
  partnerContacts      PartnerContact[]
  partnerDeals         PartnerDeal[]
  partnerTasks         PartnerTask[]
  assignedPartnerTasks PartnerTaskAssignee[]
}

// ============================================================================
// Business-portal CRM — a lightweight Companies/Contacts/Deals/Tasks module
// for partner accounts to run their own client-management workflow from
// /business-portal. Every model below is scoped to exactly one partner
// account via `partnerId` and must never be visible to another account
// (enforced by filtering every query on partnerId — see requirePartnerAction
// in src/lib/auth/dal.ts — not by the schema itself). Unrelated to the
// directory listing models above except sharing the same User/login.
// ============================================================================

enum PartnerDealStatus {
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

model PartnerCompany {
  id        String    @id @default(cuid())
  name      String
  industry  Industry?
  phone     String?
  website   String?
  address   String?
  notes     String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  partner   User   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId String

  contacts PartnerContact[]
  deals    PartnerDeal[]
  tasks    PartnerTask[]

  @@index([partnerId])
  @@index([partnerId, name])
}

model PartnerContact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String?
  email     String?
  phone     String?
  title     String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner   User   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId String

  company   PartnerCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?

  deals PartnerDeal[]
  tasks PartnerTask[]

  @@index([partnerId])
  @@index([companyId])
  @@index([partnerId, lastName, firstName])
}

model PartnerDeal {
  id                String            @id @default(cuid())
  title             String
  value             Decimal           @default(0) @db.Decimal(12, 2)
  status            PartnerDealStatus @default(DISCOVERY)
  expectedCloseDate DateTime?
  notes             String?           @db.Text
  wonAt             DateTime?
  lostAt            DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  partner   User   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId String

  company   PartnerCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?

  contact   PartnerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?

  tasks PartnerTask[]

  @@index([partnerId])
  @@index([companyId])
  @@index([contactId])
  @@index([partnerId, status])
}

model PartnerTask {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  partner   User   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId String

  company   PartnerCompany? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String?

  contact   PartnerContact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String?

  deal   PartnerDeal? @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId String?

  assignees PartnerTaskAssignee[]

  @@index([partnerId])
  @@index([companyId])
  @@index([contactId])
  @@index([dealId])
  @@index([partnerId, dueDate])
}

// Who's responsible for a PartnerTask — a join table from day one even
// though a business-portal account is a single login today, so a future
// teammate added under the same account can be assigned without a breaking
// migration later. Every assignee must belong to the task's own partner
// account; enforced in the server actions, not the schema.
model PartnerTaskAssignee {
  id String @id @default(cuid())

  task   PartnerTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([taskId, userId])
  @@index([userId])
}

enum DirectoryApprovalMode {
  EVERY_SUBMISSION
  FIRST_SUBMISSION_ONLY
  NONE
}

model Settings {
  id                    String                @id @default("singleton")
  currency              String                @default("USD")
  directoryApprovalMode DirectoryApprovalMode @default(EVERY_SUBMISSION)
}

// Admin-configured outbound email (new-lead alerts to partners, partner
// replies to leads) — set from /admin (see src/lib/email-settings.ts),
// unlike this app's other integrations (Google Places, OpenRouter), which
// stay plain env vars. A non-technical admin can set or change this without
// asking a developer to redeploy with new env vars. Singleton, same pattern
// as Settings above. username/encryptedPassword are both nullable since
// some SMTP relays allow unauthenticated submission.
model EmailSettings {
  id                String  @id @default("singleton")
  host              String
  port              Int     @default(587)
  username          String?
  // AES-256-GCM ("iv:authTag:ciphertext", base64) via src/lib/secret-crypto.ts.
  encryptedPassword String? @db.Text
  fromName          String
  fromEmail         String

  updatedAt DateTime @updatedAt
}

// Admin-configured WhatsApp Business Platform (Cloud API) connection
// (new-lead pings to partners) — same reasoning as EmailSettings above.
// Unlike the source CRM's own WhatsAppAccount, there's no businessAccountId
// or webhook verify token here: this app only ever sends a proactive
// template message, it never receives inbound messages.
model WhatsAppSettings {
  id                   String  @id @default("singleton")
  phoneNumberId        String
  // AES-256-GCM ("iv:authTag:ciphertext", base64) via src/lib/secret-crypto.ts.
  encryptedAccessToken String  @db.Text
  // Fetched and cached from Meta at the moment a connection test last
  // succeeded (see updateWhatsAppSettings) — shown in the admin form so a
  // saved connection reads as "this real phone number", not just a
  // hard-to-verify ID.
  displayPhoneNumber   String?

  updatedAt DateTime @updatedAt
}

enum PartnerListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

// publishedSnapshot is a JSON copy of the public fields as they were the
// last time an admin approved them, and is the only thing the public
// directory ever renders — a partner's live edits never reach the public
// page until approved again. The partner's own User.email/User.phone are
// never part of the snapshot: visitors reach a partner only through the
// lead form (DirectoryLead), never directly.
model PartnerListing {
  id           String               @id @default(cuid())
  slug         String               @unique
  // The Recommend link's own `?r=` tag (see recommendUrl in
  // src/app/[locale]/[slug]/page.tsx) — a short, generated-once code, not
  // this row's own id, so a shared link stays short and doesn't leak the
  // cuid. Nullable rather than backfilled: generated lazily, the first time
  // a listing's public page is actually rendered (see
  // getOrCreateReferralCode), since nothing needs one before that.
  referralCode String?              @unique
  status       PartnerListingStatus @default(DRAFT)

  companyName    String
  tagline        String?
  description    String?   @db.Text
  services       Json // ServiceEntry[] (src/lib/directory.ts) — {title, description, price}
  industry       Industry?
  website        String?
  videos         Json? // VideoEntry[] (src/lib/directory.ts) — {url, title, category, thumbnailUrl}
  address        String?   @db.Text
  city           String?
  state          String?
  country        String?
  operatingHours Json? // OperatingHours (src/lib/directory.ts)
  faqs           Json? // FaqEntry[] (src/lib/directory.ts) — {question, answer}
  updates        Json? // ListingUpdateEntry[] (src/lib/directory.ts) — {kind, title, body, endDate}
  translations   Json? // ListingTranslations (src/lib/directory.ts) — {zh?, ms?}
  logoUrl        String?   @db.Text // data: URL
  // Ordered DirectoryListingImage ids selected as gallery photos (see
  // uploadListingGalleryPhoto in src/app/actions/directory-images.ts) —
  // display order is this array's own order.
  photoIds       String[]  @default([])
  seoTitle       String?
  seoDescription String?

  reviewNote        String?   @db.Text
  submittedAt       DateTime?
  reviewedAt        DateTime?
  publishedAt       DateTime?
  publishedSnapshot Json?

  // Bumped once per real page load of the public listing page (see
  // incrementListingViewCount) — never reset on unpublish/republish, so it
  // reads as the listing's all-time total rather than "since it last went
  // live". viewCountEn/Zh/Ms is the same count broken down by which
  // language page was actually loaded (DirectoryLocale in
  // src/lib/directory-i18n.ts) — viewCount itself is their sum, kept as its
  // own column rather than computed on read since it's already what every
  // existing view (the public page's own counter, the business-portal
  // listing cards) shows today.
  viewCount   Int @default(0)
  viewCountEn Int @default(0)
  viewCountZh Int @default(0)
  viewCountMs Int @default(0)

  // Lets a listing opt into showing the total value of its own WON leads
  // to whoever referred them (see DirectoryLead.referrerId) — off by
  // default, since a deal's value is otherwise only ever shown to the
  // listing's own owner (see getDirectoryLeadStatsForPartner's wonValue).
  shareWonValueWithReferrers Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner   User   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId String

  leads         DirectoryLead[]
  images        DirectoryListingImage[]
  categories    PartnerListingCategory[]
  referralViews ListingReferralView[]

  @@index([status])
  @@index([partnerId])
}

model BusinessCategory {
  id   String @id @default(cuid())
  name String @unique

  createdAt DateTime @default(now())

  listings PartnerListingCategory[]
}

model PartnerListingCategory {
  id String @id @default(cuid())

  listing   PartnerListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  category   BusinessCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String

  @@unique([listingId, categoryId])
  @@index([categoryId])
}

// Two unrelated uses share this table (and its /api/directory-images/[id]
// route), both just "an image byte blob owned by a listing": About-field
// embedded images (markdown-lite editor), referenced by id from inside the
// About text itself, and gallery photos (see PartnerListing.photoIds),
// referenced by id from that ordered array instead. `caption` and `gallery`
// are only ever set for the latter — an About-embed's description lives in
// the surrounding markdown, not on the image row, and has no grouping of
// its own either. `gallery` is a partner's own free-text label (e.g.
// "Office", "Team", "2024 Event"), not a fixed enum like a video's
// category — the public page groups photos under it (see PhotoLightbox)
// once a listing has more than one distinct value among its photos.
model DirectoryListingImage {
  id       String  @id @default(cuid())
  mimeType String
  data     String  @db.Text
  caption  String?
  gallery  String?

  createdAt DateTime @default(now())

  listing   PartnerListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  @@index([listingId])
}

// Declared in workflow order so the partner-facing status picker can list
// them as-is.
enum DirectoryLeadStatus {
  NEW
  PICKED_UP
  CONTACTED
  QUOTED
  WON
  LOST
}

model DirectoryLead {
  id     String              @id @default(cuid())
  status DirectoryLeadStatus @default(NEW)

  name    String
  email   String
  phone   String?
  company String?
  message String  @db.Text
  locale  String  @default("en")

  value Decimal? @db.Decimal(12, 2)
  notes String?  @db.Text

  pickedUpAt     DateTime?
  firstRepliedAt DateTime?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Set from the `r=<referral code>` query param the listing page's own
  // Recommend button appends to its share link (see recommendUrl in
  // src/app/[locale]/[slug]/layout.tsx) — true when this lead arrived
  // through that link AND `r` names this exact listing (checked in
  // submitDirectoryLead, which is also where the value is carried in,
  // via a hidden form field — see directory-lead-form.tsx — rather than
  // a cookie, since the lead form lives on the same page load the query
  // param arrives on). The plain Share button's link is never tagged, so
  // this is specifically "referred", not "arrived with any query string".
  viaReferral Boolean @default(false)

  // The signed-in partner who shared the Recommend link this lead arrived
  // through, if any (see the link's own `via=<User.id>` companion param,
  // added alongside `r` only when the sharer was signed in). Always a
  // strict subset of viaReferral leads — never set on a lead that isn't
  // also viaReferral, and never trusted beyond "this really is a PARTNER
  // account" (see submitDirectoryLead). SetNull rather than Cascade: this
  // lead is the listing owner's own business record and outlives the
  // referring partner's account.
  referrer   User?   @relation(fields: [referrerId], references: [id], onDelete: SetNull)
  referrerId String?

  listing   PartnerListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  replies DirectoryLeadReply[]

  @@index([listingId, status])
  @@index([createdAt])
  @@index([referrerId])
}

// author is always the partner user replying from the business portal —
// delivered by email from a system sender, never the partner's own address.
model DirectoryLeadReply {
  id        String    @id @default(cuid())
  body      String    @db.Text
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  sendError String?   @db.Text

  lead   DirectoryLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  @@index([leadId])
}

// How many times a specific signed-in partner's own copy of a listing's
// Recommend link (see the `via=<User.id>` param described on
// DirectoryLead.referrerId) has been opened — one row per (listing,
// referrer) pair, upserted by recordListingReferralView on every matching
// page view. Unlike a lead, a view creates no row of its own to carry this
// on, so it needs its own table rather than a column somewhere. Cascade
// both sides (unlike DirectoryLead.referrer): this row's only reason to
// exist is the pair itself, so either side disappearing leaves nothing
// worth keeping.
model ListingReferralView {
  id        String   @id @default(cuid())
  viewCount Int      @default(0)
  updatedAt DateTime @updatedAt

  listing   PartnerListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  referrer   User   @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  referrerId String

  @@unique([listingId, referrerId])
  @@index([referrerId])
}

enum Industry {
  TECHNOLOGY
  RETAIL_ECOMMERCE
  HEALTHCARE
  FINANCE_BANKING
  MANUFACTURING
  CONSTRUCTION_REAL_ESTATE
  EDUCATION
  HOSPITALITY_TOURISM
  PROFESSIONAL_SERVICES
  MEDIA_ENTERTAINMENT
  TRANSPORTATION_LOGISTICS
  AGRICULTURE
  ENERGY_UTILITIES
  GOVERNMENT_NONPROFIT
  TELECOMMUNICATIONS
  AUTOMOTIVE
  FOOD_BEVERAGE
  LEGAL
  MARKETING_ADVERTISING
  OTHER
}
