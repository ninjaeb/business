// Prisma schema for the Gotka Business Directory (business.gotka.com)
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PARTNER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  title        String?
  role         Role     @default(PARTNER)
  phone        String?
  companyName  String?
  timezone     String?
  currency     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  partnerListings      PartnerListing[]
  directoryLeadReplies DirectoryLeadReply[]

  // Leads/views attributed to this partner's own Recommend link for
  // someone else's (or their own) listing — see DirectoryLead.referrerId
  // and ListingReferralView.
  referredDirectoryLeads DirectoryLead[]
  listingReferralViews   ListingReferralView[]

  // Business-portal CRM — see the models below.
  partnerCompanies     PartnerCompany[]
  partnerContacts      PartnerContact[]
  partnerDeals         PartnerDeal[]
  partnerTasks         PartnerTask[]
  assignedPartnerTasks PartnerTaskAssignee[]

  // Editorial pillar/guide content this account (an admin) has authored —
  // see DirectoryGuide.
  directoryGuides DirectoryGuide[]
}

// ============================================================================
// Business-portal CRM — a lightweight Companies/Contacts/Deals/Tasks module
// for partner accounts to run their own client-management workflow from
// /business-portal. Every model below is scoped to exactly one partner
// account via `partnerId` and must never be visible to another account
// (enforced by filtering every query on partnerId — see requirePartnerAction
// in src/lib/auth/dal.ts — not by the schema itself). Unrelated to the
// directory listing models above except sharing the same User/login.
// ============================================================================

enum PartnerDealStatus {
  NEW
  CONTACTED
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

model PartnerCompany {
  id        String    @id @default(cuid())
  name      String
  industry  Industry?
  phone     String?
  website   String?
  address   String?
  notes     String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  partner   User   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId String

  contacts PartnerContact[]
  deals    PartnerDeal[]
  tasks    PartnerTask[]

  @@index([partnerId])
  @@index([partnerId, name])
}

model PartnerContact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String?
  email     String?
  phone     String?
  title     String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner   User   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId String

  company   PartnerCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?

  deals PartnerDeal[]
  tasks PartnerTask[]

  @@index([partnerId])
  @@index([companyId])
  @@index([partnerId, lastName, firstName])
}

model PartnerDeal {
  id                String            @id @default(cuid())
  title             String
  value             Decimal           @default(0) @db.Decimal(12, 2)
  status            PartnerDealStatus @default(NEW)
  expectedCloseDate DateTime?
  notes             String?           @db.Text
  wonAt             DateTime?
  lostAt            DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  partner   User   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId String

  company   PartnerCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?

  contact   PartnerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?

  tasks PartnerTask[]

  // The directory lead(s) this deal was created from, if any — see
  // DirectoryLead.convertedDeal above. A deal created directly in the CRM
  // (not via a lead conversion) simply has none.
  convertedFromLeads DirectoryLead[]

  @@index([partnerId])
  @@index([companyId])
  @@index([contactId])
  @@index([partnerId, status])
}

model PartnerTask {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  partner   User   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId String

  company   PartnerCompany? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String?

  contact   PartnerContact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String?

  deal   PartnerDeal? @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId String?

  assignees PartnerTaskAssignee[]

  @@index([partnerId])
  @@index([companyId])
  @@index([contactId])
  @@index([dealId])
  @@index([partnerId, dueDate])
}

// Who's responsible for a PartnerTask — a join table from day one even
// though a business-portal account is a single login today, so a future
// teammate added under the same account can be assigned without a breaking
// migration later. Every assignee must belong to the task's own partner
// account; enforced in the server actions, not the schema.
model PartnerTaskAssignee {
  id String @id @default(cuid())

  task   PartnerTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([taskId, userId])
  @@index([userId])
}

enum DirectoryApprovalMode {
  EVERY_SUBMISSION
  FIRST_SUBMISSION_ONLY
  NONE
}

model Settings {
  id                    String                @id @default("singleton")
  currency              String                @default("USD")
  directoryApprovalMode DirectoryApprovalMode @default(EVERY_SUBMISSION)
}

// Admin-configured outbound email (new-lead alerts to partners, partner
// replies to leads) — set from /admin (see src/lib/email-settings.ts),
// unlike this app's other integrations (Google Places, OpenRouter), which
// stay plain env vars. A non-technical admin can set or change this without
// asking a developer to redeploy with new env vars. Singleton, same pattern
// as Settings above. username/encryptedPassword are both nullable since
// some SMTP relays allow unauthenticated submission.
model EmailSettings {
  id                String  @id @default("singleton")
  host              String
  port              Int     @default(587)
  username          String?
  // AES-256-GCM ("iv:authTag:ciphertext", base64) via src/lib/secret-crypto.ts.
  encryptedPassword String? @db.Text
  fromName          String
  fromEmail         String

  updatedAt DateTime @updatedAt
}

// Admin-configured WhatsApp Business Platform (Cloud API) connection
// (new-lead pings to partners) — same reasoning as EmailSettings above.
// Unlike the source CRM's own WhatsAppAccount, there's no businessAccountId
// or webhook verify token here: this app only ever sends a proactive
// template message, it never receives inbound messages.
model WhatsAppSettings {
  id                   String  @id @default("singleton")
  phoneNumberId        String
  // AES-256-GCM ("iv:authTag:ciphertext", base64) via src/lib/secret-crypto.ts.
  encryptedAccessToken String  @db.Text
  // Fetched and cached from Meta at the moment a connection test last
  // succeeded (see updateWhatsAppSettings) — shown in the admin form so a
  // saved connection reads as "this real phone number", not just a
  // hard-to-verify ID.
  displayPhoneNumber   String?

  updatedAt DateTime @updatedAt
}

enum PartnerListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

// publishedSnapshot is a JSON copy of the public fields as they were the
// last time an admin approved them, and is the only thing the public
// directory ever renders — a partner's live edits never reach the public
// page until approved again. The partner's own User.email/User.phone are
// never part of the snapshot: visitors reach a partner only through the
// lead form (DirectoryLead), never directly.
model PartnerListing {
  id           String               @id @default(cuid())
  slug         String               @unique
  // The Recommend link's own `?r=` tag (see recommendUrl in
  // src/app/[locale]/[slug]/page.tsx) — a short, generated-once code, not
  // this row's own id, so a shared link stays short and doesn't leak the
  // cuid. Nullable rather than backfilled: generated lazily, the first time
  // a listing's public page is actually rendered (see
  // getOrCreateReferralCode), since nothing needs one before that.
  referralCode String?              @unique
  status       PartnerListingStatus @default(DRAFT)

  companyName              String
  tagline                  String?
  description              String?   @db.Text
  services                 Json // ServiceEntry[] (src/lib/directory.ts) — {title, description, price}
  industry                 Industry?
  website                  String?
  // The partner's own Google Business Profile share link (Profile > Share)
  // — pasted in by hand, not fetched via any Google API (see
  // formatUpdateForGoogleBusinessProfile in src/lib/google-business-profile.ts
  // for why: Google restricts programmatic posting to approved partners).
  // Used only to open the partner's own profile in a new tab when they use
  // "Post to Google" on a News/Promotion entry — never shown publicly.
  googleBusinessProfileUrl String?
  // Google's own rating for this business, as of the last time a partner
  // ran AI Auto Create against a Google Maps place (see
  // autoCreateListingDetails in src/app/actions/directory.ts, which writes
  // these two columns directly rather than through the editor's own
  // review-and-save flow) — a fact fetched straight from Google Places,
  // never partner-entered or AI-written, and deliberately not exposed as
  // an editable field anywhere: showing a business's own claimed rating
  // would defeat the point of it being Google's, not theirs. Null until a
  // partner has linked a Google Maps place at least once, or when Google
  // itself has no rating for that place.
  googleRating             Float?
  googleRatingCount        Int?
  // The Google Maps listing the rating above came from (PlaceDetails.
  // googleMapsUrl) — what the public page's own star rating links out to,
  // so a visitor can read the reviews behind the number rather than just
  // being told to trust it. Same provenance/never-editable rule as
  // googleRating itself; null on a listing whose rating was set before this
  // column existed, until the next AI Auto Create run or ratings backfill.
  googleMapsUrl            String?
  // The business's own public "write a review" link — auto-filled from
  // Google Places (search.google.com/local/writereview?placeid=...) when
  // AI Auto Create or the address search resolves a Google Maps listing
  // (see autoCreateListingDetails/getAddressFromGooglePlace in
  // src/app/actions/directory.ts), or pasted in by hand otherwise — e.g.
  // the short g.page/r/.../review link from Google Business Profile's own
  // "Get more reviews" tool. Unlike googleBusinessProfileUrl above, this
  // one IS shown publicly: it's the "Leave it on Google too" link on the
  // Testimonials page (see TestimonialForm).
  googleReviewUrl          String?
  // The business's own public contact number — shown on the public listing
  // page as a click-to-call button (see PublishedListingSnapshot's own
  // comment on why this is a different thing from User.phone). Stored
  // normalized (leading "+", no spaces/dashes — see normalizePhone in
  // src/lib/phone.ts), same convention as every other phone field in this
  // app (DirectoryLead.phone, User.phone).
  phone                    String?
  // A separate number for the public WhatsApp button — deliberately not the
  // same field as `phone` above, since a business's WhatsApp Business
  // number is often different from the one it takes calls on. No Google
  // Places field maps to this (Google Business Profile has no WhatsApp
  // concept), so AI Auto Create never fills it in — a partner sets it by
  // hand. Same normalized-string convention as `phone`.
  whatsAppNumber           String?
  videos                   Json? // VideoEntry[] (src/lib/directory.ts) — {url, title, category, thumbnailUrl}
  address                  String?   @db.Text
  city                     String?
  state                    String?
  country                  String?
  operatingHours           Json? // OperatingHours (src/lib/directory.ts)
  faqs                     Json? // FaqEntry[] (src/lib/directory.ts) — {question, answer}
  updates                  Json? // ListingUpdateEntry[] (src/lib/directory.ts) — {kind, title, body, endDate}
  translations             Json? // ListingTranslations (src/lib/directory.ts) — {zh?, ms?}
  logoUrl                  String?   @db.Text // data: URL
  // Ordered DirectoryListingImage ids selected as gallery photos (see
  // uploadListingGalleryPhoto in src/app/actions/directory-images.ts) —
  // display order is this array's own order.
  photoIds                 String[]  @default([])
  seoTitle                 String?
  seoDescription           String?

  reviewNote        String?   @db.Text
  submittedAt       DateTime?
  reviewedAt        DateTime?
  publishedAt       DateTime?
  publishedSnapshot Json?

  // Bumped once per real page load of the public listing page (see
  // incrementListingViewCount) — never reset on unpublish/republish, so it
  // reads as the listing's all-time total rather than "since it last went
  // live". viewCountEn/Zh/Ms is the same count broken down by which
  // language page was actually loaded (DirectoryLocale in
  // src/lib/directory-i18n.ts) — viewCount itself is their sum, kept as its
  // own column rather than computed on read since it's already what every
  // existing view (the public page's own counter, the business-portal
  // listing cards) shows today.
  viewCount   Int @default(0)
  viewCountEn Int @default(0)
  viewCountZh Int @default(0)
  viewCountMs Int @default(0)

  // Lets a listing opt into showing the total value of its own WON leads
  // to whoever referred them (see DirectoryLead.referrerId) — off by
  // default, since a deal's value is otherwise only ever shown to the
  // listing's own owner (see getDirectoryLeadStatsForPartner's wonValue).
  shareWonValueWithReferrers Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner   User   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId String

  leads         DirectoryLead[]
  images        DirectoryListingImage[]
  categories    PartnerListingCategory[]
  referralViews ListingReferralView[]
  branchLinksA  PartnerListingBranchLink[] @relation("BranchLinkA")
  branchLinksB  PartnerListingBranchLink[] @relation("BranchLinkB")
  testimonials  DirectoryTestimonial[]

  @@index([status])
  @@index([partnerId])
}

// One row per linked pair of branches (same partner's other locations of
// the same business) — undirected, so listingAId/listingBId are always
// stored with the lexicographically smaller id first (see
// branchLinkPairKey in src/lib/directory.ts) rather than as a hub-and-spoke
// tree or a duplicated pair of rows in each direction. "Branches of X" is
// then just every row where X appears on either side, read from whichever
// listing's editor a partner opens — linking is symmetric by construction,
// not something each side has to set up separately.
model PartnerListingBranchLink {
  id         String   @id @default(cuid())
  listingAId String
  listingBId String
  createdAt  DateTime @default(now())

  listingA PartnerListing @relation("BranchLinkA", fields: [listingAId], references: [id], onDelete: Cascade)
  listingB PartnerListing @relation("BranchLinkB", fields: [listingBId], references: [id], onDelete: Cascade)

  @@unique([listingAId, listingBId])
  @@index([listingBId])
}

model BusinessCategory {
  id   String @id @default(cuid())
  name String @unique

  createdAt DateTime @default(now())

  listings PartnerListingCategory[]
}

model PartnerListingCategory {
  id String @id @default(cuid())

  listing   PartnerListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  category   BusinessCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String

  @@unique([listingId, categoryId])
  @@index([categoryId])
}

// Three unrelated uses share this table (and its /api/directory-images/[id]
// route), all just "an image byte blob owned by a listing or a guide":
// About-field embedded images (markdown-lite editor) on a listing,
// gallery photos (see PartnerListing.photoIds), and About-field embedded
// images on a DirectoryGuide below — referenced by id from inside the
// relevant markdown body, or (gallery photos only) from that ordered
// array instead. `caption` and `gallery` are only ever set for gallery
// photos — an embed's description lives in the surrounding markdown, not
// on the image row, and has no grouping of its own either. `gallery` is a
// partner's own free-text label (e.g. "Office", "Team", "2024 Event"), not
// a fixed enum like a video's category — the public page groups photos
// under it (see PhotoLightbox) once a listing has more than one distinct
// value among its photos. Exactly one of listingId/guideId is set on any
// row — enforced in the two upload actions (uploadDirectoryListingImage/
// uploadDirectoryGuideImage), not the schema itself, same convention as
// every other cross-table invariant in this file.
model DirectoryListingImage {
  id       String  @id @default(cuid())
  mimeType String
  data     String  @db.Text
  caption  String?
  gallery  String?

  createdAt DateTime @default(now())

  listing   PartnerListing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String?

  guide   DirectoryGuide? @relation(fields: [guideId], references: [id], onDelete: Cascade)
  guideId String?

  @@index([listingId])
  @@index([guideId])
}

enum DirectoryGuideStatus {
  DRAFT
  PUBLISHED
}

// A long-form editorial "pillar" guide (e.g. "The Complete Guide to
// Coworking Spaces in Malaysia") published by Gotka itself — see
// src/app/admin/guides (write, admin-only) and src/app/[locale]/guides
// (read, public). Unlike a PartnerListing, there's no owning partner and
// no separate review/approve step: an admin drafts it and publishes it
// directly, so `status` alone (not a snapshot) gates what the public
// pages read. `industry` is optional and only ever used to cross-link a
// guide from the matching industry page (see industry-page-content.tsx) —
// a guide with no clear industry fit is simply never cross-linked.
// English-only for now — no per-locale translations table like
// PartnerListing.translations, a deliberate scope cut to ship a working
// pillar-content type without also building trilingual long-form
// authoring in the same pass.
model DirectoryGuide {
  id       String               @id @default(cuid())
  slug     String               @unique
  title    String
  // A short, direct definition/summary — doubles as the meta description
  // and the index page's own "definition-first" excerpt under the title.
  excerpt  String               @db.Text
  body     String               @db.Text
  status   DirectoryGuideStatus @default(DRAFT)
  industry Industry?

  seoTitle       String?
  seoDescription String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  images DirectoryListingImage[]

  @@index([status])
  @@index([industry])
}

// Declared in workflow order so the partner-facing status picker can list
// them as-is. Picking "Qualified Deal" in that picker (see
// DirectoryLeadStatusSelect/convertDirectoryLeadToDeal) creates a
// PartnerDeal from this lead's own name/email/phone/company and moves it
// straight to CLOSED_CONVERTED — there's no persisted QUALIFIED_DEAL value
// to land on in between.
enum DirectoryLeadStatus {
  NEW
  PICKED_UP
  CONTACTED
  CLOSED_CONVERTED
}

model DirectoryLead {
  id     String              @id @default(cuid())
  status DirectoryLeadStatus @default(NEW)

  name    String
  email   String
  phone   String?
  company String?
  message String  @db.Text
  locale  String  @default("en")

  value Decimal? @db.Decimal(12, 2)
  notes String?  @db.Text

  pickedUpAt     DateTime?
  firstRepliedAt DateTime?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Set from the `r=<referral code>` query param the listing page's own
  // Recommend button appends to its share link (see recommendUrl in
  // src/app/[locale]/[slug]/layout.tsx) — true when this lead arrived
  // through that link AND `r` names this exact listing (checked in
  // submitDirectoryLead, which is also where the value is carried in,
  // via a hidden form field — see directory-lead-form.tsx — rather than
  // a cookie, since the lead form lives on the same page load the query
  // param arrives on). The plain Share button's link is never tagged, so
  // this is specifically "referred", not "arrived with any query string".
  viaReferral Boolean @default(false)

  // The signed-in partner who shared the Recommend link this lead arrived
  // through, if any (see the link's own `via=<User.id>` companion param,
  // added alongside `r` only when the sharer was signed in). Always a
  // strict subset of viaReferral leads — never set on a lead that isn't
  // also viaReferral, and never trusted beyond "this really is a PARTNER
  // account" (see submitDirectoryLead). SetNull rather than Cascade: this
  // lead is the listing owner's own business record and outlives the
  // referring partner's account.
  referrer   User?   @relation(fields: [referrerId], references: [id], onDelete: SetNull)
  referrerId String?

  listing   PartnerListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  // Set once, by convertDirectoryLeadToDeal, the moment this lead is
  // qualified — a plain link back to the CRM record it turned into, so its
  // own page can offer a "View deal" link rather than leaving a partner to
  // go find it. SetNull (not Cascade): deleting the deal later shouldn't
  // take this lead's own history with it.
  convertedDeal   PartnerDeal? @relation(fields: [convertedDealId], references: [id], onDelete: SetNull)
  convertedDealId String?

  replies DirectoryLeadReply[]

  @@index([listingId, status])
  @@index([createdAt])
  @@index([referrerId])
  @@index([convertedDealId])
}

// author is always the partner user replying from the business portal —
// delivered by email from a system sender, never the partner's own address.
model DirectoryLeadReply {
  id        String    @id @default(cuid())
  body      String    @db.Text
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  sendError String?   @db.Text

  lead   DirectoryLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  @@index([leadId])
}

enum DirectoryTestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

// A visitor-written testimonial on a listing's own Testimonials page (see
// TestimonialForm) — always PENDING until an admin approves it (see
// approveDirectoryTestimonial/rejectDirectoryTestimonial in
// src/app/actions/testimonials.ts), unlike DirectoryLead above, which needs
// no such gate since a lead is private to the partner. A testimonial is
// headed for public display, the same trust boundary every other
// visitor-facing content on this site (PartnerListing.status itself) already
// enforces. No author email/phone, unlike DirectoryLead: there's never a
// reason to contact a testimonial's author back, and a lighter form lowers
// the bar to actually writing one.
model DirectoryTestimonial {
  id     String                     @id @default(cuid())
  status DirectoryTestimonialStatus @default(PENDING)

  authorName String
  rating     Int?
  body       String  @db.Text
  locale     String  @default("en")

  reviewNote String?   @db.Text
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  listing   PartnerListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  @@index([listingId, status])
  @@index([status])
}

// How many times a specific signed-in partner's own copy of a listing's
// Recommend link (see the `via=<User.id>` param described on
// DirectoryLead.referrerId) has been opened — one row per (listing,
// referrer) pair, upserted by recordListingReferralView on every matching
// page view. Unlike a lead, a view creates no row of its own to carry this
// on, so it needs its own table rather than a column somewhere. Cascade
// both sides (unlike DirectoryLead.referrer): this row's only reason to
// exist is the pair itself, so either side disappearing leaves nothing
// worth keeping.
model ListingReferralView {
  id        String   @id @default(cuid())
  viewCount Int      @default(0)
  updatedAt DateTime @updatedAt

  listing   PartnerListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  referrer   User   @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  referrerId String

  @@unique([listingId, referrerId])
  @@index([referrerId])
}

enum Industry {
  TECHNOLOGY
  RETAIL_ECOMMERCE
  HEALTHCARE
  FINANCE_BANKING
  MANUFACTURING
  CONSTRUCTION_REAL_ESTATE
  EDUCATION
  HOSPITALITY_TOURISM
  PROFESSIONAL_SERVICES
  MEDIA_ENTERTAINMENT
  TRANSPORTATION_LOGISTICS
  AGRICULTURE
  ENERGY_UTILITIES
  GOVERNMENT_NONPROFIT
  TELECOMMUNICATIONS
  AUTOMOTIVE
  FOOD_BEVERAGE
  LEGAL
  MARKETING_ADVERTISING
  OTHER
}
