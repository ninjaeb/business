  TECHNOLOGY
  RETAIL_ECOMMERCE
  HEALTHCARE
  FINANCE_BANKING
  MANUFACTURING
  CONSTRUCTION_REAL_ESTATE
  EDUCATION
  HOSPITALITY_TOURISM
  PROFESSIONAL_SERVICES
  MEDIA_ENTERTAINMENT
  TRANSPORTATION_LOGISTICS
  AGRICULTURE
  ENERGY_UTILITIES
  GOVERNMENT_NONPROFIT
  TELECOMMUNICATIONS
  AUTOMOTIVE
  FOOD_BEVERAGE
  LEGAL
  MARKETING_ADVERTISING
  OTHER
}
