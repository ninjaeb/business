# Required
DATABASE_URL=              # postgresql://user:pass@host:5432/db
SESSION_SECRET=            # openssl rand -base64 32 — signs the business_session cookie
SITE_URL=                  # public origin, no trailing slash, e.g. https://business.gotka.com

# Sign-up
GOOGLE_CLIENT_ID=          # optional — "Continue with Google" on sign-up/login
GOOGLE_CLIENT_SECRET=
GOOGLE_PLACES_API_KEY=     # optional — "AI Auto Create" listing autofill from Google Places (Places API (New))

# AI-assisted listing content (rewrite/generate/translate, AI Auto Create,
# business-card scanning) — routed through OpenRouter via the openai SDK,
# not api.openai.com directly. Optional — features stay off unset.
OPENROUTER_API_KEY=
# Text-only requests (generate/rewrite/translate, AI Auto Create's written
# content). A comma-separated priority list — the first is primary, the
# rest are OpenRouter fallbacks tried automatically if it's unavailable.
# Defaults to 4 free models chosen for speed (no default "reasoning" pass,
# unlike most of OpenRouter's other free models, which was slow in
# practice) — the max OpenRouter's `models` field actually allows is a
# primary plus 3 fallbacks, a longer list gets a 400 error. Set one
# specific paid model instead for consistent quality/latency once you
# outgrow it (a single value with no comma is fine).
OPENROUTER_MODEL=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-lightning:free,cohere/north-mini-code:free
# Image-bearing requests (business-card scanning) — needs a vision-capable
# model, which the pinned OPENROUTER_MODEL above isn't. Defaults to
# openrouter/free, OpenRouter's own dynamic free-tier router, which picks
# whichever free backend model is currently available and vision-capable.
OPENROUTER_VISION_MODEL=openrouter/free

# Outbound email (new-lead alerts to partners, partner replies to leads) and
# WhatsApp new-lead alerts (official Meta WhatsApp Business Platform, Cloud
# API) are both configured from /admin, not env vars — a non-technical admin
# can set or change either without a redeploy. See README's "WhatsApp
# notifications" section for the Meta setup and message template needed.

# Search/AI-search discovery (each independent; feature just stays off unset)
GOOGLE_SITE_VERIFICATION=  # Search Console "HTML tag" method content=
BING_SITE_VERIFICATION=    # Bing Webmaster Tools, same method
INDEXNOW_KEY=              # openssl rand -hex 16 — pings Bing/Yandex/Naver/Seznam on publish/unpublish
PLAUSIBLE_DOMAIN=          # Plausible Analytics
PLAUSIBLE_SCRIPT_URL=      # leave unset for plausible.io's hosted script
GA_MEASUREMENT_ID=         # Google Analytics (GA4) — optional override; defaults to business.gotka.com's own property (hardcoded in src/app/[locale]/layout.tsx) unset

# Deploy automation (GitHub push webhook -> auto pull/install/migrate/restart)
DEPLOY_WEBHOOK_SECRET=     # openssl rand -base64 32 — required together with DEPLOY_BRANCH
DEPLOY_BRANCH=             # exact branch name this environment auto-deploys from
DEPLOY_SMOKE_URL=          # public origin the post-deploy smoke test checks; falls back to SITE_URL
