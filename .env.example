# Required
DATABASE_URL=              # postgresql://user:pass@host:5432/db
SESSION_SECRET=            # openssl rand -base64 32 — signs the business_session cookie
SITE_URL=                  # public origin, no trailing slash, e.g. https://business.gotka.com

# Sign-up
GOOGLE_CLIENT_ID=          # optional — "Continue with Google" on sign-up/login
GOOGLE_CLIENT_SECRET=
GOOGLE_PLACES_API_KEY=     # optional — "AI Auto Create" listing autofill from Google Places (Places API (New))

# AI-assisted listing content (rewrite/generate/translate, AI Auto Create,
# business-card scanning) — routed through OpenRouter via the openai SDK,
# not api.openai.com directly. Optional — features stay off unset.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Outbound email (new-lead alerts to partners, partner replies to leads)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Gotka Business Directory
MAIL_FROM_EMAIL=

# WhatsApp new-lead alerts to partners — official Meta WhatsApp Business
# Platform (Cloud API), never an unofficial/browser-automation integration.
# Optional — feature stays off unset. Needs a pre-approved message
# template; see README's "WhatsApp notifications" section for Meta setup
# and the exact template to submit.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Search/AI-search discovery (each independent; feature just stays off unset)
GOOGLE_SITE_VERIFICATION=  # Search Console "HTML tag" method content=
BING_SITE_VERIFICATION=    # Bing Webmaster Tools, same method
INDEXNOW_KEY=              # openssl rand -hex 16 — pings Bing/Yandex/Naver/Seznam on publish/unpublish
PLAUSIBLE_DOMAIN=          # Plausible Analytics
PLAUSIBLE_SCRIPT_URL=      # leave unset for plausible.io's hosted script

# Deploy automation (GitHub push webhook -> auto pull/install/migrate/restart)
DEPLOY_WEBHOOK_SECRET=     # openssl rand -base64 32 — required together with DEPLOY_BRANCH
DEPLOY_BRANCH=             # exact branch name this environment auto-deploys from
DEPLOY_SMOKE_URL=          # public origin the post-deploy smoke test checks; falls back to SITE_URL
